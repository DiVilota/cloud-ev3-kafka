# Variables del compose de la raiz (docker-compose.yml).
# Copiar como .env:   cp .env.example .env

# --- Frontends: repos aparte, clonados al lado de este ----------------------
# Ruta relativa a ESTE directorio. Cada uno los clona con su nombre.
CONSOLA_DIR=../cloud-ev3-front
TIENDA_DIR=../pedidos360-tienda

# --- Direccion publica del sistema ------------------------------------------
# La direccion por la que el NAVEGADOR llega a los servicios. Afecta CORS,
# el returnUrl de Webpay y las API_* de los dos frontends.
#   local -> localhost      AWS -> IP publica de la EC2   (sin http:// ni puerto)
HOST_PUBLICO=localhost

# --- Kafka ---------------------------------------------------------------
# Host que los brokers ANUNCIAN a los clientes que viven FUERA de la red de
# Docker (por ejemplo, un consumidor corriendo en el host).
#   local -> localhost      AWS -> IP publica de la EC2   (sin http:// ni puerto)
KAFKA_HOST=localhost

# --- MySQL (una instancia, una base por microservicio) ---------------------
MYSQL_PASS=123456

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=pedidos360
RABBITMQ_PASS=pedidos360
# Credencial con la que los 3 nodos se aceptan entre si. En AWS, cambiarla.
RABBITMQ_ERLANG_COOKIE=pedidos360-cookie-dev

# --- Antifraude ----------------------------------------------------------------
# Pepper del SHA-256 de la huella de tarjeta. En AWS, cambiarlo.
ANTIFRAUDE_PEPPER=pedidos360-dev

# --- DynamoDB (ms-recomendaciones) -----------------------------------------
# Comentado = DynamoDB Local del compose. En el Learner Lab, dejarlo VACIO
# (DYNAMODB_ENDPOINT=) y pegar las credenciales temporales de "AWS Details".
# DYNAMODB_ENDPOINT=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# true = escribe un snapshot de metricas cada 5 s en EventosOperaciones, la
# tabla con Streams que dispara la Lambda del dashboard en AWS.
DYNAMODB_PUBLICAR_OPERACIONES=false

# --- Dashboard --------------------------------------------------------------
# Vacio = WebSocket local de ms-recomendaciones (ws://localhost:8084/ws/metricas).
# En AWS: el wss:// del API Gateway que sale del terraform.
WS_URL=

# --- Simulacion de logistica (ms-carrito) ------------------------------------
# Cada cuanto avanza un paso el estado de envio de los pedidos pagados.
ENVIOS_AVANCE_MS=20000
